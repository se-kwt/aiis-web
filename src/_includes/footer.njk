<footer class="footer" data-section="footer" data-k="footer-root">
    <div class="footer__banner">
      <div class="footer__logo" data-k="footer-logo"><a href="/" aria-label="Aspire Indian International School home"><img data-k="footer-logo-img" src="assets/logos/crest-web.png" alt="Aspire Indian International School crest" width="113" height="86"></a></div>
      <div class="footer__middle">
        <section class="footer__locations" aria-label="Campus">
