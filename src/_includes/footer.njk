              <div class="footer__grades" data-k="footer-campus1-grades">Pre-KG to Grade 10</div>
              <div class="footer__address" data-k="footer-campus1-address">Abbasiya, Kuwait</div>
              <div class="footer__city"><a href="mailto:info@aiis.example" data-placeholder="sample email address">info@aiis.example</a></div>
              <div class="footer__phone"><a href="tel:+96500000000" data-k="footer-campus1-phone" data-placeholder="sample phone number">+965 0000 0000</a></div>
            </article>
          </div>
        </section>
      </div>
