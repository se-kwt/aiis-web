{%- macro amp(s) -%}{{ s | escape | replace("&#39;", "'") | safe }}{%- endmacro -%}<aside class="page-sidebar">
          <div class="page-sidebar__card">
            <h3>About Us</h3>
            <p>{{ amp(settings.about) }}</p>
          </div>
          <div class="page-sidebar__card">
            <h3>Quick Links</h3>
            <ul class="page-sidebar__links">
{% for link in settings.quickLinks %}              <li><a href="{{ link.path }}">{{ amp(link.label) }}</a></li>
{% endfor %}            </ul>
          </div>
          <div class="page-sidebar__card">
            <h3>Address</h3>
            <address class="page-sidebar__contact">
{% for line in settings.address.lines %}              {{ amp(line) }}<br>
{% endfor %}{% for p in settings.address.phones %}              <a href="tel:{{ p }}">{{ p | replace(r/^(.{4})(.{3})(.*)$/, "$1 $2 $3") }}</a>{% if not loop.last %}<br>{% endif %}
{% endfor %}            </address>
          </div>
        </aside>