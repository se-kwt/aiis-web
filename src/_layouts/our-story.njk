{% extends "./base.njk" %}
{% set title = "Our Story | Aspire Indian International School" %}
{% set styles = ["tokens", "base", "header", "intro", "hero", "promises", "our-story", "footer"] %}
{% block content %}  <!-- build:our-story --><div class="story" data-section="our-story" data-k="our-story-root">

    <!-- 1. title band + full-bleed photo -->
    <section class="story-hero" aria-labelledby="story-hero-title">
      <p class="story-hero__eyebrow">{{ ourStory.hero.eyebrow | safe }}</p>
      <h1 id="story-hero-title" class="story-hero__title">{{ ourStory.hero.title | safe }}</h1>
      <div class="story-hero__frame">
        <span class="story-hero__notch" aria-hidden="true"></span>
        <figure class="tp" data-temp-photo>
          <span class="sr">Placeholder — a photo of {{ ourStory.hero.photoDescription | safe }} is not yet in place</span>
        </figure>
      </div>
    </section>

    <!-- 2. lead headline + copy + callout -->
    <section class="story-lead">
      <div class="story__wrap">
        <h2 class="story-lead__title animate-text">{{ ourStory.lead.title | hl | markdownInline | safe }}</h2>
        <p class="story-lead__copy">{{ ourStory.lead.copy | markdownInline | safe }}</p>
        <p class="story-lead__callout"{{ ourStory.lead.callout | placeholderAttr | safe }}>{{ ourStory.lead.callout.text | markdownInline | safe }}</p>
      </div>
    </section>

    <!-- 3. quick facts carousel -->
    <section class="story-facts" aria-labelledby="story-facts-title">
      <svg class="story-facts__waves" viewBox="0 0 1400 300" fill="none" aria-hidden="true" focusable="false">
        <path d="M0,180 C150,80 300,260 450,170 S750,60 900,160 S1150,250 1400,140" stroke="currentColor" stroke-width="1.2"/>
        <path d="M0,120 C150,220 300,40 450,130 S750,240 900,120 S1150,30 1400,160" stroke="currentColor" stroke-width="1.2"/>
        <path d="M0,220 C150,140 300,280 450,210 S750,110 900,210 S1150,290 1400,200" stroke="currentColor" stroke-width="1.2"/>
      </svg>
      <h2 id="story-facts-title" class="story-facts__heading">Quick Facts</h2>
      <div class="story__wrap story-facts__viewport">
        <ul class="story-facts__track" data-facts-track>
          {%- for fact in ourStory.quickFacts %}
          <li class="story-facts__card"><span class="story-facts__num"{{ fact | placeholderAttr | safe }}>{{ fact.figure | safe }}</span><p class="story-facts__label">{{ fact.label | markdownInline | safe }}</p></li>
          {%- endfor %}
        </ul>
        <div class="story-facts__nav">
          <button class="story-facts__arrow" type="button" data-facts-prev aria-label="Previous facts"><svg aria-hidden="true" width="18" height="12" viewBox="0 0 18 12" fill="none"><path d="M17 6H1m5-5L1 6l5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <button class="story-facts__arrow" type="button" data-facts-next aria-label="Next facts"><svg aria-hidden="true" width="18" height="12" viewBox="0 0 18 12" fill="none"><path d="M1 6h16m-5-5l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
      </div>
    </section>

    <!-- 4. mission statement -->
    <section class="story-mission">
      <div class="story__wrap">
        <p class="story-mission__eyebrow">{{ ourStory.mission.eyebrow | safe }}</p>
        <h2 class="story-mission__title animate-text"{{ ourStory.mission.title | placeholderAttr | safe }}>{{ ourStory.mission.title.text | hl | markdownInline | safe }}</h2>
        <div class="story-mission__cols">
          {%- for col in ourStory.mission.cols %}
          <div class="story-mission__col">
            <h3>{{ col.heading | safe }}</h3>
            <p{{ col.text | placeholderAttr | safe }}>{{ col.text.text | markdownInline | safe }}</p>
          </div>
          {%- endfor %}
        </div>
      </div>
    </section>

    <!-- 5. alternating story blocks -->
    <div class="story-blocks">
      {%- for block in ourStory.storyBlocks %}{% if not loop.first %}
{% endif %}
      <article class="story-block">
        <svg class="story-block__swirl" viewBox="0 0 100 100" fill="none" aria-hidden="true" focusable="false"><path d="M50 90c-22 0-36-16-36-36 0-18 14-32 32-32 15 0 27 11 27 25 0 12-9 21-21 21-9 0-16-7-16-16 0-7 6-12 12-12" stroke="currentColor" stroke-width="2"/></svg>
        <div class="story__wrap story-block__grid">
          {%- if loop.index % 2 == 1 %}
          <div class="story-block__copy">
            <h3 class="story-block__heading">{{ block.heading | safe }}</h3>
            <p{{ block.copy | placeholderAttr | safe }}>{{ block.copy.text | markdownInline | safe }}</p>
            <a class="story-block__link" href="{{ block.linkHref }}">{{ block.linkLabel | markdownInline | safe }}<svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          </div>
          <div class="story-block__media">
            <figure class="tp" data-temp-photo>
              <span class="sr">Placeholder — a photo of {{ block.photoDescription | safe }} is not yet in place</span>
            </figure>
          </div>
          {%- else %}
          <div class="story-block__media">
            <figure class="tp" data-temp-photo>
              <span class="sr">Placeholder — a photo of {{ block.photoDescription | safe }} is not yet in place</span>
            </figure>
          </div>
          <div class="story-block__copy">
            <h3 class="story-block__heading">{{ block.heading | safe }}</h3>
            <p{{ block.copy | placeholderAttr | safe }}>{{ block.copy.text | markdownInline | safe }}</p>
            <a class="story-block__link" href="{{ block.linkHref }}">{{ block.linkLabel | markdownInline | safe }}<svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          </div>
          {%- endif %}
        </div>
      </article>
      {%- endfor %}
    </div>

    <!-- 6. closing destination bars -->
    <section class="story-closing" aria-label="Keep exploring AIIS">
      <div class="story__wrap">
        <ul class="story-closing__list">
          {%- for link in ourStory.closing %}
          <li><a class="story-closing__link" href="{{ link.path }}">{{ link.label | markdownInline | safe }}</a></li>
          {%- endfor %}
        </ul>
      </div>
    </section>

  </div><!-- /build:our-story -->
{% endblock %}
