{% extends "./base.njk" %}
{% set styles = ["tokens", "base", "header", "intro", "hero", "news", "promises", "divisions", "learning", "teachers", "values", "closing", "footer", "video-modal"] %}
{% block content %}{% macro amp(s) %}{{ s | escape | replace("&#39;", "'") | safe }}{% endmacro %}    <section class="hero" data-section="hero" data-k="hero-root">
      <div class="hero__band" aria-hidden="true"></div>
      <div class="hero__intro">
        <p class="hero__eyebrow" data-k="hero-eyebrow"{{ homepage.hero.eyebrow | placeholderAttr | safe }}>{{ (homepage.hero.eyebrow.text or homepage.hero.eyebrow) | safe }}</p>
        <h1 class="hero__title" data-k="hero-heading">{{ homepage.hero.heading | words("hero-heading-word1") | safe }}</h1>
        <p class="hero__desc" data-k="hero-desc"{{ homepage.hero.desc | placeholderAttr | safe }}>{{ amp(homepage.hero.desc.text or homepage.hero.desc) }}</p>
      </div>
      <a class="hero__badge" href="{{ homepage.hero.videoUrl }}" target="_blank" rel="noopener" data-k="hero-badge" data-video-modal data-video-src="{{ homepage.hero.video }}" data-video-title="{{ amp(homepage.hero.videoTitle) }}">
        <span class="hero__disc" aria-hidden="true"></span>
        <span class="hero__ring" data-k="hero-badge-ring" aria-hidden="true"><span class="hero__ring-spin"><svg viewBox="0 0 120 120" aria-hidden="true"><defs><path id="hero-ring-path" d="M60 60m-47 0a47 47 0 1 1 94 0a47 47 0 1 1 -94 0"/></defs><text><textPath href="#hero-ring-path" textLength="290" lengthAdjust="spacing">WATCH FULL VIDEO · WATCH FULL VIDEO · </textPath></text></svg></span></span>
        <span class="hero__icon" data-k="hero-badge-icon" aria-hidden="true"><svg viewBox="0 0 40 28" width="40" height="28" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"><rect x="2" y="3" width="25" height="22" rx="2"/><path d="M27 11l11-6v18l-11-6z"/></svg></span>
        <span class="sr">{{ amp(homepage.hero.videoTitle) }}</span>
      </a>
      <div class="hero__reel-track" data-k="hero-reel-track">
        <div class="hero__reel-stage">
          <div class="hero__reel-mask" data-k="hero-reel-mask">
            <div class="hero__reel-wipe" data-k="hero-reel-wipe">
              <video data-k="hero-video" src="{{ homepage.hero.video }}" muted autoplay loop playsinline preload="auto" aria-label="{{ amp(homepage.hero.videoAlt) }}"></video>
            </div>
          </div>
          <div class="hero__shape" data-k="hero-shape-bottom"><button class="hero__ctl" type="button" data-hero-toggle data-k="hero-video-control" aria-pressed="false"><span class="sr">Pause background video</span><span class="hero__ctl-disc" aria-hidden="true"><i></i><i></i></span></button></div>
        </div>
      </div>
    </section>
    <section class="news" data-section="news" data-k="news-root">
      <ul class="news__list" data-k="news-list">
          <li data-k="news-item1"><button class="news__trigger" type="button" data-news-trigger data-k="news-trigger1"><span>NEWS</span><em data-k="news-slash1"></em><span>SOCIAL</span></button><span class="news__icon" data-k="news-icon1"><span class="news__icon-art" data-k="news-icon1-art"><span></span></span><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg></span></li>
          <li aria-hidden="true" data-k="news-item1-loop"><button tabindex="-1" class="news__trigger" type="button" data-news-trigger data-k="news-trigger1-loop"><span>NEWS</span><em data-k="news-slash1-loop"></em><span>SOCIAL</span></button><span class="news__icon" data-k="news-icon1-loop"><span class="news__icon-art" data-k="news-icon1-art-loop"><span></span></span><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg></span></li>
          <li data-k="news-item1-loop" aria-hidden="true"><button class="news__trigger" type="button" data-news-trigger data-k="news-trigger1-loop" tabindex="-1"><span>NEWS</span><em data-k="news-slash1-loop"></em><span>SOCIAL</span></button><span class="news__icon" data-k="news-icon1-loop"><span class="news__icon-art" data-k="news-icon1-art-loop"><span></span></span><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg></span></li>
          <li data-k="news-item1-loop" aria-hidden="true"><button class="news__trigger" type="button" data-news-trigger data-k="news-trigger1-loop" tabindex="-1"><span>NEWS</span><em data-k="news-slash1-loop"></em><span>SOCIAL</span></button><span class="news__icon" data-k="news-icon1-loop"><span class="news__icon-art" data-k="news-icon1-art-loop"><span></span></span><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg></span></li>
      </ul>
      <div class="news-panel" id="news-panel" role="dialog" aria-modal="true" aria-labelledby="news-panel-title" aria-hidden="true">
        <div class="news-panel__top">
          <h2 class="news-panel__heading" id="news-panel-title">NEWS / SOCIAL</h2>
          <button class="news-panel__close" type="button" data-news-close><span class="sr">Close</span><svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M1 15L15 1M1 1l14 14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></button>
        </div>
        <div class="news-panel__tabs" role="tablist" aria-label="News and social">
          <button type="button" role="tab" id="news-tab-news" aria-selected="true" aria-controls="news-tabpanel-news" data-news-tab="news">News</button>
          <button type="button" role="tab" id="news-tab-social" aria-selected="false" aria-controls="news-tabpanel-social" data-news-tab="social" tabindex="-1">Social</button>
        </div>
        <div class="news-panel__body">
          <ul class="news-panel__cards" role="tabpanel" id="news-tabpanel-news" aria-labelledby="news-tab-news">{% for item in homepage.news.items %}<li><a class="news-panel__card" href="/news-events"><span class="news-panel__eyebrow">NEWS</span><span class="news-panel__title"{{ item.headline | placeholderAttr | safe }}>{{ amp(item.headline.text or item.headline) }}</span></a></li>{% endfor %}</ul>
          <ul class="news-panel__cards" role="tabpanel" id="news-tabpanel-social" aria-labelledby="news-tab-social" hidden>{% for item in homepage.news.social %}<li><a class="news-panel__card" href="#"><span class="news-panel__eyebrow">SOCIAL</span><span class="news-panel__title"{{ item.headline | placeholderAttr | safe }}>{{ amp(item.headline.text or item.headline) }}</span></a></li>{% endfor %}</ul>
        </div>
      </div>
    </section>
