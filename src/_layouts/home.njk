    </section>
    <section class="divisions" data-section="divisions" data-k="divisions-root">
      <div class="divisions__intro">
        <h2 class="divisions__heading animate-text" data-k="divisions-heading"><em data-k="divisions-heading-small1">{{ amp(homepage.divisions.heading.small[0]) }}</em> <span class="word" data-k="divisions-heading-big1">{{ amp(homepage.divisions.heading.big[0]) }}</span> <span class="word" data-k="divisions-heading-big1">{{ amp(homepage.divisions.heading.big[1]) }}</span> <em data-k="divisions-heading-small1">{{ amp(homepage.divisions.heading.small[1]) }}</em> <span class="word" data-k="divisions-heading-big1">{{ amp(homepage.divisions.heading.big[2]) }}</span></h2>
      </div>
      <div class="divisions__stage">
        <span class="divisions__lines" data-k="divisions-lines" aria-hidden="true"></span>
        <div class="divisions__grid" data-k="divisions-grid">{% for card in homepage.divisions.cards %}
      <div class="divisions__col">
        <article class="flipcard" data-flip data-k="divisions-card1">
          <div class="flipcard__flipper">
            <div class="flipcard__front" id="division{{ loop.index }}-front" data-k="divisions-card1-front">
              <figure class="tp flipcard__photo"><img src="{{ card.photo.src }}" alt="{{ amp(card.photo.alt) }}" loading="lazy"></figure>
              <span class="flipcard__shade" data-k="divisions-card1-shade" aria-hidden="true"></span>
              <header class="flipcard__title" data-k="divisions-card1-title">
                <h3 class="flipcard__head"><strong class="flipcard__verb">{{ amp(card.verb) }}</strong> <span class="flipcard__grades">{{ amp(card.grades) }}</span></h3>
                <div class="flipcard__more"><p class="flipcard__school">{{ amp(card.school) }}</p></div>
              </header>
              <span class="flipcard__corner" data-k="divisions-card1-corner" aria-hidden="true"></span>
              <button class="flipcard__btn" type="button" data-flip-toggle aria-expanded="false" aria-controls="division{{ loop.index }}-back"><span class="sr">Read more: {{ amp(card.verb) }}, {{ amp(card.grades) }}</span></button>
              <span class="plus" data-k="divisions-card1-toggle" aria-hidden="true"><span></span></span>
            </div>
            <div class="flipcard__back" id="division{{ loop.index }}-back" data-k="divisions-card1-back" inert>
              <span class="flipcard__texture" data-k="divisions-card1-back-texture" aria-hidden="true"></span>
              <div class="flipcard__content">
                <h3 class="flipcard__head"><strong class="flipcard__verb">{{ amp(card.verb) }}</strong> <span class="flipcard__grades">{{ amp(card.grades) }}</span></h3>
                <p class="flipcard__school">{{ amp(card.school) }}</p>
                <p class="flipcard__text"><span class="flipcard__lead">{{ amp(card.lead) }}</span>{{ amp(card.trail) }}</p>
              </div>
              <span class="flipcard__corner" aria-hidden="true"></span>
              <button class="flipcard__btn" type="button" data-flip-toggle aria-expanded="false" aria-controls="division{{ loop.index }}-back"><span class="sr">Close: {{ amp(card.verb) }}, {{ amp(card.grades) }}</span></button>
              <span class="plus" aria-hidden="true"><span></span></span>
            </div>
          </div>
        </article>
      </div>{% endfor %}
        </div>
      </div>
    </section>
    <section class="learning" data-section="learning" data-k="learning-root">
      <span class="learning__lines learning__lines--top" data-k="learning-lines-top" aria-hidden="true"></span>
      <span class="learning__lines learning__lines--bottom" data-k="learning-lines-bottom" aria-hidden="true"></span>
      <div class="learning__wrap">
        <div class="learning__intro">
          <h2 class="learning__statement animate-text" data-k="learning-heading"><span class="learning__spacer" aria-hidden="true"></span>{{ homepage.learning.heading | hl(homepage.learning.headingDataK) | safe }}</h2>
        </div>
        <div class="learning__panel" data-k="learning-panel">
          <header class="learning__title" data-k="learning-title"><h2 class="animate-text" data-k="learning-title-text">{{ homepage.learning.title.lead | words | safe }} <em>{{ homepage.learning.title.emphasis | words | safe }}</em> {{ homepage.learning.title.trail | words | safe }}</h2></header>
          <div class="learning__frame" data-k="learning-video-frame">
            <figure class="tp"><video data-k="learning-video" src="{{ homepage.learning.video }}" poster="{{ homepage.learning.poster }}" muted loop playsinline preload="none" aria-label="{{ amp(homepage.learning.videoAlt) }}"></video></figure>
            <button class="learning__ctl" type="button" data-learning-toggle data-k="learning-video-control" aria-pressed="false"><span class="sr">Pause video</span><i aria-hidden="true"></i><i aria-hidden="true"></i></button>
          </div>
        </div>
        <div class="learning__cols" data-k="learning-columns">
        <div class="learning__colwrap" data-reveal="fade-up" data-reveal-delay="50">
          <div class="learning__col" data-k="learning-col1">
            <figure class="tp learning__icon" data-k="learning-col1-icon"><img src="{{ homepage.learning.columns[0].icon.src }}" alt="{{ amp(homepage.learning.columns[0].icon.alt) }}" loading="lazy"></figure>
            <div class="learning__body"><h2 data-k="learning-col1-title">{{ amp(homepage.learning.columns[0].title) }}</h2><p data-k="learning-col1-text"><span class="lead-in">{{ amp(homepage.learning.columns[0].leadIn) }}</span>{{ amp(homepage.learning.columns[0].trail) }}</p></div>
          </div>
        </div>
        <div class="learning__colwrap" data-reveal="fade-up" data-reveal-delay="400">
          <div class="learning__col" data-k="learning-col1">
            <figure class="tp learning__icon" data-k="learning-col1-icon"><img src="{{ homepage.learning.columns[1].icon.src }}" alt="{{ amp(homepage.learning.columns[1].icon.alt) }}" loading="lazy"></figure>
            <div class="learning__body"><h2 data-k="learning-col1-title">{{ amp(homepage.learning.columns[1].title) }}</h2><p data-k="learning-col1-text"><span class="lead-in">{{ amp(homepage.learning.columns[1].leadIn) }}</span>{{ amp(homepage.learning.columns[1].trail) }}</p></div>
          </div>
        </div>
        <div class="learning__colwrap" data-reveal="fade-up" data-reveal-delay="750">
          <div class="learning__col" data-k="learning-col1">
            <figure class="tp learning__icon" data-k="learning-col1-icon"><img src="{{ homepage.learning.columns[2].icon.src }}" alt="{{ amp(homepage.learning.columns[2].icon.alt) }}" loading="lazy"></figure>
            <div class="learning__body"><h2 data-k="learning-col1-title">{{ amp(homepage.learning.columns[2].title) }}</h2><p data-k="learning-col1-text"><span class="lead-in">{{ amp(homepage.learning.columns[2].leadIn) }}</span>{{ amp(homepage.learning.columns[2].trail) }}</p></div>
          </div>
        </div>
        </div>
      </div>
    </section>
    <section class="teachers" data-section="teachers" data-k="teachers-root">
      <span class="teachers__lines teachers__lines--bottom" data-k="teachers-lines-bottom" aria-hidden="true"></span>
      <div class="teachers__inner">
        <h2 class="teachers__heading animate-text" data-k="teachers-heading"><img class="teachers__icon" data-k="teachers-heading-icon" src="assets/logos/crest-web.png" alt="" width="96" height="73">{{ homepage.teachers.heading | hl(homepage.teachers.headingDataK) | safe }}</h2>
        <div class="teachers__carousel" data-carousel role="region" aria-roledescription="carousel" aria-label="Meet our teachers">
          <span class="teachers__lines teachers__lines--top" data-k="teachers-lines-top" aria-hidden="true"></span>
          <div class="teachers__slider" data-k="teachers-slider">
            <ul class="teachers__track" data-track>{% for slide in homepage.teachers.slides %}
            <li class="teachers__slide" data-k="teachers-slide1" data-slide-index="{{ loop.index0 }}" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} of 7">
              <figure class="tp teachers__photo" data-k="teachers-slide1-photo">
                <figcaption class="teachers__caption" data-k="teachers-slide1-caption"><span class="teachers__corner teachers__corner--l" data-k="teachers-slide1-corner" aria-hidden="true"></span><span class="teachers__corner teachers__corner--r" aria-hidden="true"></span><p data-k="teachers-slide1-role"{{ slide.role | placeholderAttr | safe }}>{{ amp(slide.role.text or slide.role) }}</p><h3 data-k="teachers-slide1-name"{{ slide.name | placeholderAttr | safe }}>{{ amp(slide.name.text or slide.name) }}</h3></figcaption>
              </figure>
              <button class="teachers__play" type="button" data-temp-video data-k="teachers-slide1-play" data-video-src="{{ slide.video }}" data-video-title="{{ amp(slide.videoTitle) }}"><span class="teachers__disc" data-k="teachers-slide1-play-icon" aria-hidden="true"></span><span class="sr"{{ slide.playLabel | placeholderAttr | safe }}>Play Full Video: {{ amp(slide.name.text or slide.name) }}</span></button>
            </li>{% endfor %}
            </ul>
          </div>
          <div class="teachers__controls">
            <div class="teachers__paging" data-k="teachers-paging" aria-live="polite" aria-atomic="true"><span class="sr">Card </span><span class="teachers__cur" data-k="teachers-paging-current">01</span><span class="teachers__sep" aria-hidden="true">/</span><span class="teachers__tot"><span class="sr">of </span>07</span></div>
            <div class="teachers__arrows">
              <button class="teachers__arrow teachers__arrow--prev" type="button" data-prev data-k="teachers-prev" aria-label="Previous teacher"><svg aria-hidden="true" width="18" height="12" viewBox="0 0 18 12" fill="none"><path d="M17 6H1m5-5L1 6l5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              <span class="teachers__sep" aria-hidden="true">/</span>
              <button class="teachers__arrow teachers__arrow--next" type="button" data-next data-k="teachers-next" aria-label="Next teacher"><svg aria-hidden="true" width="18" height="12" viewBox="0 0 18 12" fill="none"><path d="M1 6h16m-5-5l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="values" data-section="values" data-k="values-root">
      <div class="values__cols" data-k="values-columns">
        <div class="values__col values__col--list">{% for card in homepage.values.cards %}
          <div class="value-button-container" data-k="values-button1">
            <div class="value-button">
              <figure class="tp value-fig" data-k="values-button1-photo">
                <figcaption><h2>{{ amp(card.title) }}</h2></figcaption>
                <img src="{{ card.photo.src }}" alt="{{ amp(card.photo.alt) }}" loading="lazy">
              </figure>
              <span class="value-open" data-k="values-button1-open"></span>
              <div class="colorblock" data-k="values-button1-corner"><span class="plus" data-k="values-button1-toggle" aria-hidden="true"><span></span></span></div>
            </div>
          </div>{% endfor %}
        </div>
        <div class="values__col values__col--words">
          <div class="values-intro">
            <h2 class="animate-text" data-k="values-heading">{{ homepage.values.heading.lead | words | safe }}
              <em data-k="values-heading-small1">{{ homepage.values.heading.small1 | words | safe }}</em>
              {{ homepage.values.heading.mid | words | safe }}
              <em data-k="values-heading-small1">{{ homepage.values.heading.small2 | words | safe }}</em>
              {{ homepage.values.heading.trail | words | safe }}</h2>
            <div class="values-spiral" data-k="values-spiral"><div class="values-spiral__in"><img src="assets/art/values-spiral.svg" alt="" width="100" height="100"></div></div>
          </div>
        </div>
      </div>
    </section>
    <section class="closing" data-section="closing" data-k="closing-root">
      <picture class="closing__spiral" data-k="closing-spiral"><img src="assets/art/closing-spirograph.svg" alt="" width="1440" height="960"></picture>
      <div class="closing__intro">
        <h2 class="animate-text" data-k="closing-heading"><em data-k="closing-heading-small">{{ amp(homepage.closing.heading.small) }}</em>
          <span class="word" data-k="closing-heading-big1">{{ amp(homepage.closing.heading.big[0]) }}</span>
          <span class="word" data-k="closing-heading-big1">{{ amp(homepage.closing.heading.big[1]) }}</span>
          <span class="word" data-k="closing-heading-big1">{{ amp(homepage.closing.heading.big[2]) }}</span></h2>
        <div class="closing__foot">
          <a class="large-button" href="{{ homepage.closing.buttonPath }}" data-k="closing-button"><span class="inner" data-k="closing-button-label"><span>{{ amp(homepage.closing.buttonLabel) }}</span><span aria-hidden="true">{{ amp(homepage.closing.buttonLabel) }}</span></span></a>
          <ul class="closing__links" aria-label="{{ amp(homepage.closing.buttonLabel) }}">{% for link in homepage.closing.links %}
            <li><a href="{{ link.path }}" data-k="closing-link">{{ amp(link.label) }}</a></li>{% endfor %}
          </ul>
        </div>
      </div>
    </section>
{% endblock %}
