          <div class="promise__cutout-art" data-parallax="20">
            <figure class="tp tp--cutout" data-k="promise2-figure"><img src="{{ homepage.promises[1].figure.src }}" alt="{{ amp(homepage.promises[1].figure.alt) }}" loading="lazy"></figure>
          </div>
        </div>
        <div class="promise__media">
          <div class="promise__inset">
            <figure class="tp" data-k="promise2-photo"><img src="{{ homepage.promises[1].photo.src }}" alt="{{ amp(homepage.promises[1].photo.alt) }}" loading="lazy" data-parallax-image="1.3"></figure>
          </div>
          <h2 class="promise__title animate-text" data-k="promise2-heading"><span class="promise__spacer" aria-hidden="true"></span>{{ homepage.promises[1].heading | hl(homepage.promises[1].headingDataK) | safe }}</h2>
        </div>
        </div>
      </article>
      <article class="promise promise--left" data-k="promise3-container">
        <div class="promise__grid">
          <p class="promise__intro"><span class="promise__lead" data-k="promise3-lead">{{ amp(homepage.promises[2].lead) }}</span></p>
        <div class="promise__media">
          <div class="promise__inset">
            <figure class="tp" data-k="promise3-photo"><img src="{{ homepage.promises[2].photo.src }}" alt="{{ amp(homepage.promises[2].photo.alt) }}" loading="lazy" data-parallax-image="1.3"></figure>
          </div>
          <h2 class="promise__title animate-text" data-k="promise3-heading"><span class="promise__spacer" aria-hidden="true"></span>{{ homepage.promises[2].heading | hl(homepage.promises[2].headingDataK) | safe }}</h2>
        </div>
