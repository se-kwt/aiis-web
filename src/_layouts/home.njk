          <div class="promise__cutout-art" data-parallax="20">
            <figure class="tp tp--cutout" data-k="promise1-figure"><img src="{{ homepage.promises[0].figure.src }}" alt="{{ amp(homepage.promises[0].figure.alt) }}" loading="lazy"></figure>
          </div>
        </div>
        </div>
      </article>
      <article class="promise promise--right" data-k="promise2-container">
        <div class="promise__grid">
          <p class="promise__intro"><span class="promise__lead" data-k="promise2-lead">{{ amp(homepage.promises[1].lead) }}</span></p>
        <div class="promise__cutout">
